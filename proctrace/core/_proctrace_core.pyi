from typing import Self
 
DEFAULT_SAMPLE_CAPACITY: int

def probe_version() -> str: ...

class ResourceSnapshot:
    rss_bytes: int
    vms_bytes: int
    open_fds: int
    timestamp_ns: int
    def rss_mb(self) -> float: ...
    def vms_mb(self) -> float: ...

class ExtendedResourceSnapshot:
    rss_bytes: int
    vms_bytes: int
    open_fds: int
    timestamp_ns: int
    cpu_user_ns: int
    cpu_sys_ns: int
    vol_ctx: int
    invol_ctx: int
    minor_faults: int
    major_faults: int
    io_read_bytes: int
    io_write_bytes: int
    io_rchar_bytes: int
    io_wchar_bytes: int
    sockets_by_state: dict[str, int]
    thread_cpu: list[tuple[int, str, int, int]]
    def rss_mb(self) -> float: ...
    def vms_mb(self) -> float: ...
    def cpu_user_s(self) -> float: ...
    def cpu_sys_s(self) -> float: ...

class BackgroundSampler:
    DEFAULT_CAPACITY: int
    def __new__(cls, cap: int | None = None) -> Self: ...
    def start(self, interval_ms: int) -> None: ...
    def stop(self) -> int: ...
    def peak_at_ns(self) -> int: ...
    def peak_rss(self) -> int: ...
    def samples(self) -> list[tuple[int, int, int, int]]: ...

class IpcStats:
    def __new__(cls, name: str, ring_capacity: int) -> Self: ...
    def record_latency_us(self, us: int) -> None: ...
    def record_depth(self, depth: int) -> None: ...
    def avg_latency_us(self) -> float: ...
    def p99_latency_us(self) -> float: ...
    def total_messages(self) -> int: ...
    def peak_depth(self) -> int: ...
    def name(self) -> str: ...
    def report(self) -> str: ...

class SocketStats:
    def __new__(cls, name: str, ring_capacity: int) -> Self: ...
    def record_send(self, nbytes: int, latency_us: int) -> None: ...
    def record_recv(self, nbytes: int) -> None: ...
    def bytes_sent(self) -> int: ...
    def bytes_recv(self) -> int: ...
    def avg_send_latency_us(self) -> float: ...
    def p99_send_latency_us(self) -> float: ...
    def total_sends(self) -> int: ...
    def total_recvs(self) -> int: ...
    def name(self) -> str: ...
    def report(self) -> str: ...

def snapshot_resources() -> ResourceSnapshot: ...
def snapshot_extended(
    cpu: bool = False,
    io: bool = False,
    sockets: bool = False,
    threads_cpu: bool = False,
) -> ExtendedResourceSnapshot: ...
def list_open_fds() -> list[str]: ...
def register_signal_pipe(signal_num: int) -> tuple[int, int]: ...
